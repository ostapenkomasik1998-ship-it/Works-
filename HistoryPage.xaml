<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QrScanner.ViewModels"
             xmlns:models="clr-namespace:QrScanner.Models"
             x:Class="QrScanner.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Історія">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Очистити" Command="{Binding ClearCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Label Text="Історія порожня"
               HorizontalOptions="Center" VerticalOptions="Center"
               IsVisible="{Binding IsEmpty}" />

        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ScanRecord">
                    <Border Margin="12,6" Padding="12"
                            StrokeShape="RoundRectangle 12"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Value}" FontSize="16"
                                   MaxLines="3" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding ScannedAt, StringFormat='{0:dd.MM.yyyy HH:mm:ss}'}"
                                   FontSize="12" Opacity="0.6" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Відкрити" IsVisible="{Binding IsLink}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="Видалити" BackgroundColor="#D9534F"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
